<h1>カートの中身</h1>

<%# セッションキーがシンボルでも文字列でも取得できるように代入 %>
<% cart_list = session[:cart] || session["cart"] %>

<% if cart_list.present? && cart_list.any? %>
  <table>
    <thead>
      <tr>
        <th>商品名</th>
        <th>個数</th>
        <th>単価</th>
        <th>小計</th>
        <th>数量変更</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% cart_list.each do |item| %>
        <%# ハッシュのキー（文字列/シンボル）を柔軟に扱えるように変換 %>
        <% item_data = item.with_indifferent_access %>
        <% product_id = item_data[:id].to_i %>
        <% product = @products ? @products[product_id] : Product.find_by(id: product_id) %>

        <% if product %>
          <% count = item_data[:count].to_i %>
          <% item_price = item_data[:item_price] || (product.price * count) %>
          <tr>
            <td><%= link_to product.name, product_path(product) %></td>
            <td><%= count %></td>
            <td><%= "¥" + number_with_delimiter(product.price) %></td>
            <td><%= "¥" + number_with_delimiter(item_price) %></td>
            <td>
              <%= form_with url: update_quantity_cart_path(product.id), method: :post, local: true, data: { turbo: false } do %>
                <%= select_tag "count", options_for_select(0...100, count), onchange: "this.form.submit()" %>
              <% end %>
            </td>
            <td>
              <%= button_to 'カートから消す', remove_item_cart_path(product.id), method: :delete, data: { turbo_confirm: '本当に削除しますか？' }, form: { data: { turbo: false } } %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>

  <% cart_total = session[:cart_total] || session["cart_total"] %>
  <p><strong>合計金額: <%= "¥" + number_with_delimiter(cart_total.to_i) %></strong></p>

  <% if user_signed_in? %>
    <%= link_to "注文へ進む", new_order_path, class: "btn btn-primary" %>
  <% else %>
    <%= link_to "注文するにはログインまたは新規登録してください", new_user_session_path, class: "btn btn-secondary" %>
  <% end %>
<% else %>
  <p>カートは空です。</p>
<% end %>