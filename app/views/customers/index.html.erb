<p style="color: green"><%= notice %></p>

<% content_for :title, "Customers" %>

<h1>顧客一覧</h1>

<h2>検索</h2>
<%= form_with url: '/customers', local: true, method: :get do |f| %>
<table>
  <tr>
    <th>顧客名</th>
    <td><%= f.text_field :name, value: params[:name] %></td>
  </tr>
  <tr>
    <th>顧客年齢</th>
    <td><%= f.number_field :age, value: params[:age] %></td>
  </tr>
</table>
<%= f.submit 'Search' %>
<% end %>

<h2>検索結果</h2>
<table>
  <thead>
    <tr>
      <th>担当者名</th>
      <th>顧客名</th>
      <th>顧客年齢</th>
    <th colspan="3"></th>
  </tr>
</thead>


<tbody>
  <% @customers.each do |customer| %>
    <tr>
       <td><%= customer.employee.name %>(<%= customer.employee.age %>)</td>
       <td><%= customer.name %></td>
       <td><%= customer.age %></td>
       <td><%= link_to '詳細', customer %></td>
       <td><%= link_to '編集', edit_customer_path(customer) %></td>
       <td><%= link_to '削除', customer, method: :delete, data: { confirm: '本当によろしいですか?' } %></td>
    </tr>
    <% end %>
  </tbody>
</table>

  <br>
<%= link_to '新規顧客', new_customer_path %>
