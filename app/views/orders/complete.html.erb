<h1>注文完了</h1>

<h3>ご注文が完了しました。</h3>

<%# 注文に含まれる商品の一覧を繰り返し表示 %>
<% @order.order_details.each do |detail| %>
  <div class="order-detail-item">
    <h4>商品名</h4>
    <p><%= detail.product.name %></p>

    <h4>個数</h4>
    <p><%= detail.quantity %> 個</p>

    <h4>小計</h4>
    <p><%= number_with_delimiter(detail.price * detail.quantity) %> 円</p>
  </div>
  <hr>
<% end %>

<h4>合計金額</h4>
<p><%= number_with_delimiter(@order.total_price || 0) %> 円</p>